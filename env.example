# Warden environment template (copy to the dotfile the app reads, or set these as Fly secrets).
# Names only; values live in Fly secrets or your shell, never in the repo.
# The app logs which executor tier it runs on at startup and stamps the executor name on every receipt.

# ---- Admin token (arms rules and starts wallet pairing on the hosted instance)
# Get it:     make one: `openssl rand -hex 24`
# Costs:      free
# Trap:       without it the /admin routes answer 401 and nobody can arm a rule on this instance
# Without it: the public pages still render; rules are armed from the CLI on the host instead
ADMIN_TOKEN=

# ---- Binance Agentic Wallet session (not a variable: a paired CLI)
# Get it:     `baw auth signin` on the host, confirm in the Binance Wallet App; or /admin/pair on the hosted instance
# Costs:      free; the wallet pays gas on BSC (about 0.00003 BNB per swap, measured 2026-10-05)
# Trap:       the session lasts at most 48 h; tradeAllTokens must be on, or the token on the allowed list; Binance checks the caller's AND the server's region
# Without it: every scheduled rule ends as a "waited: session expired" receipt; nothing is signed
BINANCE_BAW_DIR=/data/baw

# ---- Executor tier
# agentic-wallet = the real wallet CLI (tier 1). fake = scripted responses for local UI work, stamped "fake" on every receipt.
WARDEN_EXECUTOR=agentic-wallet

# ---- Scheduler: 1 runs the 15 s clock inside the web process (the hosted instance); 0 for a read-only web copy.
RUN_SCHEDULER=1

# ---- Data directory (SQLite + receipt files + wallet session). On Fly this is the mounted volume.
WARDEN_DATA=/data

# ---- Binance Web3 API key: NOT needed by the wallet path. Only the fallback signed executor would use it, and it is not built.
# Get it:     https://web3.binance.com/en/dev-portal
# Costs:      free during the event
# Trap:       both the caller's IP and the server's location are checked; US, CA, NL, UK, JP and sanctioned regions are refused
# Without it: nothing changes in V1; the public RWA endpoints need no key
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
